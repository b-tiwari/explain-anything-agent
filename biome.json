{
	"$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
	"formatter": {
		"enabled": true,
		"includes": ["**/*.{js,jsx,ts,tsx}"],
		"formatWithErrors": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"includes": ["**/*.{js,jsx,ts,tsx}"],
		"rules": {
			"recommended": true,
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useButtonType": "off",
				"useAltText": "off"
			},
			"complexity": {
				"noBannedTypes": "off"
			},
			"style": {
				"useImportType": "error",
				"useExportType": "error"
			},
			"suspicious": {
				"noDoubleEquals": {
					"fix": "safe",
					"level": "error"
				},
				"noExplicitAny": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"trailingCommas": "all"
		},
		"linter": {
			"enabled": true
		},
		"jsxRuntime": "reactClassic"
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**/*.{js,jsx,ts,tsx,json}"],
		"ignoreUnknown": true
	}
}
